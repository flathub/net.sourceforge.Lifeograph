<interface>
  <requires lib="gtk" version="4.0"/>

  <menu id="menu_theme">
    <section>
      <item>
        <attribute name="custom">theme_name</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Edit</attribute>
        <attribute name="action">theme.edit</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Duplicate</attribute>
        <attribute name="action">theme.duplicate</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Dismiss...</attribute>
        <attribute name="action">theme.dismiss</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Reset to default</attribute>
        <attribute name="action">theme.reset</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Assign to Open Entry</attribute>
        <attribute name="action">theme.assign_to_entry</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Assign to Selected Entries</attribute>
        <attribute name="action">theme.assign_to_entries</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>

  <object class="GtkPopoverMenu" id="Po_theme">
    <property name="menu-model">menu_theme</property>

    <child type="theme_name">
      <object class="GtkEntry" id="E_theme_name"/>
    </child>
  </object>
</interface>
