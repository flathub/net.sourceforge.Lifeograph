<interface>
  <requires lib="gtk" version="4.0"/>

  <menu id="menu_calendar_day">
    <section>
      <item>
        <attribute name="label" translatable="yes">Copy Date</attribute>
        <attribute name="action">calendar.copy_date</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="custom">calendar_add_entry</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Weekend Day</attribute>
        <attribute name="action">calendar.day_is_weekend</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Holiday</attribute>
        <attribute name="action">calendar.day_is_holiday</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    <section>
    </section>
      <item>
        <attribute name="label" translatable="yes">Show Week Numbers</attribute>
        <attribute name="action">calendar.show_week_nos</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>

  <object class="GtkPopoverMenu" id="Po_calendar_day">
    <property name="menu-model">menu_calendar_day</property>

    <child type="calendar_add_entry">
      <object class="GtkBox" id="Bx_calendar_add">
        <property name="homogeneous">1</property>
        <property name="css-classes">linked</property>
        <child>
          <object class="GtkButton">
            <property name="tooltip-text" translatable="yes">Create entry</property>
            <property name="action-name">app.add_entry_dated</property>
            <child>
              <object class="GtkImage">
                <property name="pixel-size">32</property>
                <property name="icon-name">entry-32</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="tooltip-text" translatable="yes">Create milestone</property>
            <property name="action-name">app.add_milestone</property>
            <child>
              <object class="GtkImage">
                <property name="pixel-size">32</property>
                <property name="icon-name">milestone-32</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
