<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="Bx_container">
    <property name="orientation">vertical</property>
    <property name="spacing">5</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">15</property>
        <child>
          <object class="GtkLabel">
            <property name="sensitive">0</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Condition</property>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="MB_filter">
            <property name="focus-on-click">0</property>
            <property name="tooltip-text" translatable="yes">True if satisfies the selected filter</property>
            <property name="hexpand">1</property>
            <property name="halign">end</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
