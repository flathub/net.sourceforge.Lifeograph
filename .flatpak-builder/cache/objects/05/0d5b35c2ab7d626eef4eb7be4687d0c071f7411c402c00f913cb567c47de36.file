<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkWindow" id="W_export">
    <property name="resizable">0</property>
    <property name="width-request">400</property>
    <property name="modal">True</property>
    <property name="titlebar">
      <object class="GtkHeaderBar">
        <property name="show-title-buttons">False</property>
        <child>
          <object class="GtkButton" id="B_export_cancel">
            <property name="label">Cancel</property>
            <!-- <property name="has-frame">0</property> -->
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="B_export_go">
            <property name="label" translatable="yes">Export</property>
            <property name="css-classes">suggested-action</property>
            <!-- <property name="has-frame">0</property> -->
          </object>
        </child>
      </object>
    </property>
    <child>
      <object class="GtkBox" id="Bx_contents">
        <property name="valign">center</property>
        <property name="vexpand">True</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">15</property>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">2</property>
            <property name="column-spacing">15</property>
            <child>
              <object class="GtkLabel">
                <property name="sensitive">0</property>
                <property name="label" translatable="yes">Content</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="sensitive">0</property>
                <property name="label" translatable="yes">Type</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="MB_export_filter">
                <property name="hexpand">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkComboBoxText" id="CB_export_type">
                <property name="hexpand">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
