<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="Bx_container">
    <property name="orientation">vertical</property>
    <property name="spacing">5</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">15</property>
        <child>
          <object class="GtkLabel">
            <property name="sensitive">0</property>
            <property name="label" translatable="yes">Tag</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="E_tag_picker">
            <property name="primary-icon-name">tag-16-symbolic</property>
            <property name="primary-icon-activatable">0</property>
            <property name="placeholder-text" translatable="yes">Tag</property>
            <property name="halign">end</property>
            <property name="hexpand">1</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">15</property>
        <child>
          <object class="GtkLabel">
            <property name="sensitive">0</property>
            <property name="label" translatable="yes">Calculate</property>
          </object>
        </child>
        <child>
          <object class="GtkComboBoxText" id="CB_value_type">
            <property name="halign">end</property>
            <property name="hexpand">1</property>
            <items>
              <item translatable="yes">Total Planned</item>
              <item translatable="yes">Total Realized</item>
              <item translatable="yes">Total Remaining</item>
              <item translatable="yes">Average Planned</item>
              <item translatable="yes">Average Realized</item>
              <item translatable="yes">Average Remaining</item>
              <item translatable="yes">Completion Percentage</item>
            </items>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
